# Copy to .env.local only when this device has no existing local configuration.
# The local launchers also set these two flags explicitly.
NADO_LIVE=0
NADO_DEV_SEED=0

# Public WalletConnect project identifier, not a wallet secret.
# Leave blank and enter your own project ID in the connection page,
# or set it before building. Never put wallet passwords or mnemonics here.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
